PORT=5000
# PostgreSQL connection (either set DATABASE_URL or the DB_* variables below)
# Example DATABASE_URL: postgres://user:pass@localhost:5432/dbname
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/madina
DB_NAME=madina
DB_USER=postgres
DB_PASS=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
JWT_SECRET=your_jwt_secret_here
ADMIN_SECRET_KEY=your_admin_secret_here